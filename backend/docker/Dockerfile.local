# Dockerfile for local development environment

# Use python slim as base image
FROM python:3.14-slim

# Set working directory of the image. Creates /app directory from scratch, so it's empty
WORKDIR /app

# Install uv into the image.
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /bin/

# Copy dependency metadata first so dependency changes are isolated
# from application-code changes in Docker's build cache
COPY pyproject.toml uv.lock ./

# Create the uv-managed environment from the locked dependencies.
# --locked prevents uv from changing uv.lock during the build.
# --no-install-project skips installing the local project itself.
RUN uv sync --locked --no-install-project

# Copy the Django application code.
COPY project/ /app/project/

# Update working directory to the project folder
WORKDIR /app/project

# Set the default command to run when the container starts
# We use uv to run the Django server within the uv-managed environment.
# CMD ["executable", "arg1", "arg2", "..."]
CMD ["uv", "run", "python", "manage.py", "runserver", "0.0.0.0:8000"]

# RUN vs CMD vs EXEC
# RUN executes commands at build time and creates a new image layer
# CMD specifies the default command to run when a container is started from the image   
# EXEC form of CMD allows you to specify the command and its arguments as a JSON array

# To run through Docker, (-f = --file = file, -t = --tag = tag, -p = --publish = port mapping)
# docker build [options] <build-context>
# docker run [options] <image>
# 1. docker build -f docker/Dockerfile.local -t homeaway-image .
# 2. docker run -p 8000:8000 --name homeaway-container homeaway-image